namespace "managarm::swap";

enum Errors {
    SUCCESS,
    OTHER
}

enum ManageType {
    INITIALIZE,
    WRITEBACK
}

group {

message GetSwapSpaceRequest 1 {
head(128):
}

}

group {

message GetSwapSpaceResponse 1 {
head(128):
    Errors error;
}

}

group {

message ManageRequest 1 {
head(128):
    ManageType type;
    uint64 offset;
    uint64 count;
}

message ManageResponse 2 {
head(128):
    Errors error;
}

}
